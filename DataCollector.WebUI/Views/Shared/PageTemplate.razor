<PageTitle>@GetTitle</PageTitle>

<div class="page-template">
    <div class="page-template__header">
        <div class="page-template__header-left-content">
            <h1 class="page-template__title">
                @GetTitle
            </h1>
        </div>
        
        <div class="page-template__header-right-content">
            @HeaderRightContent
        </div>
    </div>
    
    <div class="page-template__content">
        @MainContent
    </div>
</div>