<!DOCTYPE html>
<html lang="uk">

<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <base href="/"/>
  @* Тема - до завантаження стилів, щоб темна тема не «блимала» світлою (повна логіка - Assets/Js/theme.js). *@
  <script>
    (function () {
      var dark = false;
      try {
        var mode = localStorage.getItem('datacollector.theme');
        dark = mode === 'dark' || (mode !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      } catch (e) { }
      document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" />
  <link rel="stylesheet" href="dist/app.min.css" />
  <ImportMap/>
  <HeadOutlet @rendermode="PageRenderMode"/>
</head>

<body>
<Root @rendermode="PageRenderMode"/>

@* Непередбачена помилка з'єднання або рендеру: Blazor показує цей блок (без нього сторінка просто «завмирає»). *@
<div id="blazor-error-ui" data-nosnippet>
  Сталася помилка - частина сторінки може не працювати.
  <a href="" class="reload">Оновити сторінку</a>
  <span class="dismiss" title="Закрити">×</span>
</div>

@* Втрата з'єднання з сервером (Blazor Server працює через постійне з'єднання): власні тексти українською
   замість стандартних англійських. Стан задають класи, які додає blazor.web.js. *@
<div id="components-reconnect-modal" class="reconnect" data-nosnippet>
  <div class="reconnect__dialog">
    <div class="reconnect__spinner"></div>
    <p class="reconnect__text reconnect__text--show">Зв'язок із сервером втрачено. Відновлюємо…</p>
    <p class="reconnect__text reconnect__text--failed">
      Не вдалося відновити зв'язок.
      <a href="#" onclick="Blazor.reconnect(); return false;">Спробувати ще раз</a>
    </p>
    <p class="reconnect__text reconnect__text--rejected">
      Сеанс завершено (сервер перезапущено).
      <a href="" onclick="location.reload(); return false;">Оновити сторінку</a>
    </p>
  </div>
</div>
<script src="dist/vendor/echarts.min.js"></script>
<script src="dist/app.min.js"></script>
<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
  [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

  /// <summary>
  /// Сторінки працюють інтерактивно (Blazor Server), крім входу: він статичний, бо має записати cookie
  /// у відповідь на звичайний HTTP-запит (див. [ExcludeFromInteractiveRouting] на сторінці Login).
  /// </summary>
  private IComponentRenderMode? PageRenderMode
    => HttpContext.AcceptsInteractiveRouting() ? new InteractiveServerRenderMode(prerender: false) : null;
}