@namespace DataCollector.WebUI.Views.Components

<button type="button"
        class="icon-button @(Danger ? "icon-button--danger" : "")"
        title="@Title"
        @onclick="OnClick"
        @onclick:stopPropagation="true">
    @switch (Icon)
    {
        case "edit":
            <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.21a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
            break;
        case "delete":
            <svg viewBox="0 0 24 24"><path d="M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
            break;
        case "open":
            <svg viewBox="0 0 24 24"><path d="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
            break;
    }
</button>

@code {
  [Parameter] public string Icon { get; set; } = "edit";
  [Parameter] public string? Title { get; set; }
  [Parameter] public bool Danger { get; set; }
  [Parameter] public EventCallback OnClick { get; set; }
}
