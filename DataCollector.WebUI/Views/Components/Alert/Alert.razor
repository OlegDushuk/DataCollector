@namespace DataCollector.WebUI.Views.Components

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert--@(Success ? "success" : "error")">
        <span class="alert__text">@Message</span>
        @if (OnClose.HasDelegate)
        {
            <button type="button" class="alert__close" title="Закрити" @onclick="OnClose">
                <svg viewBox="0 0 24 24"><path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
            </button>
        }
    </div>
}

@code {
  [Parameter] public string? Message { get; set; }
  [Parameter] public bool Success { get; set; }
  [Parameter] public EventCallback OnClose { get; set; }
}
