@namespace DataCollector.WebUI.Views.Components
@inject IJSRuntime JS

@*
    Перемикач теми внизу бічного меню: світла, темна або як у системі. Вибір зберігається в браузері
    і застосовується одразу (Assets/Js/theme.js); сервер про тему не знає - це лише CSS-змінні.
*@

<div class="theme-switcher" role="radiogroup" aria-label="Тема інтерфейсу">
    @foreach (var (mode, label, icon) in Modes)
    {
        <button type="button" role="radio" aria-checked="@(mode == _mode ? "true" : "false")" title="@(mode == "system" ? "Як у системі (світла або темна - за налаштуванням ОС)" : label)"
                class="theme-switcher__item @(mode == _mode ? "theme-switcher__item--active" : "")"
                @onclick="@(() => SetMode(mode))">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@icon" /></svg>
            <span>@label</span>
        </button>
    }
</div>

@code {
  /// <summary>Режими (Material Icons): сонце, місяць, монітор.</summary>
  private static readonly (string Mode, string Label, string Icon)[] Modes =
  [
    ("light", "Світла", "M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM2 13h2a1 1 0 0 0 0-2H2a1 1 0 0 0 0 2zm18 0h2a1 1 0 0 0 0-2h-2a1 1 0 0 0 0 2zM11 2v2a1 1 0 0 0 2 0V2a1 1 0 0 0-2 0zm0 18v2a1 1 0 0 0 2 0v-2a1 1 0 0 0-2 0zM5.99 4.58a1 1 0 0 0-1.41 1.41l1.06 1.06a1 1 0 0 0 1.41-1.41L5.99 4.58zm12.37 12.37a1 1 0 0 0-1.41 1.41l1.06 1.06a1 1 0 0 0 1.41-1.41l-1.06-1.06zm1.06-10.96a1 1 0 0 0-1.41-1.41l-1.06 1.06a1 1 0 0 0 1.41 1.41l1.06-1.06zM7.05 18.36a1 1 0 0 0-1.41-1.41l-1.06 1.06a1 1 0 0 0 1.41 1.41l1.06-1.06z"),
    ("dark", "Темна", "M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"),
    ("system", "Авто", "M20 3H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h6v2H8v2h8v-2h-2v-2h6a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm0 13H4V5h16v11z")
  ];

  private string _mode = "system";

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
      return;

    try
    {
      _mode = await JS.InvokeAsync<string>("dataCollector.theme.getMode");
      StateHasChanged();
    }
    catch (JSException)
    {
      // theme.js не завантажився (не виконано gulp) - перемикач просто показує режим за замовчуванням.
    }
  }

  private async Task SetMode(string mode)
  {
    try
    {
      _mode = await JS.InvokeAsync<string>("dataCollector.theme.setMode", mode);
    }
    catch (JSException)
    {
    }
  }
}
