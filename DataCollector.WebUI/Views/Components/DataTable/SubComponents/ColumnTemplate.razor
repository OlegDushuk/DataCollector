@typeparam TItem
@implements IDisposable

@code
{
  [CascadingParameter] public DataTable<TItem> DataTable { get; set; } = null!;
  
  [Parameter] public RenderFragment<TItem> ChildContent { get; set; } = null!;
  [Parameter] public string? Key { get; set; }
  [Parameter] public string Title { get; set; } = string.Empty;
  [Parameter] public bool IsSortable { get; set; }
  [Parameter] public bool IsFilterable { get; set; }
  [Parameter] public DataTableFilterType FilterType { get; set; }
  [Parameter] public string? Width { get; set; }

  /// <summary>Позиція колонки в таблиці (колонки, показані пізніше, інакше стали б у кінець).</summary>
  [Parameter] public int Order { get; set; }

  /// <summary>Закріпити колонку праворуч (видна при горизонтальній прокрутці широкої таблиці).</summary>
  [Parameter] public bool Sticky { get; set; }

  private readonly Column<TItem> _column = new();
  
  protected override void OnInitialized()
  {
    DataTable.AddColumn(_column);
  }

  protected override void OnParametersSet()
  {
    _column.Template = ChildContent;
    _column.Key = Key;
    _column.Title = Title;
    _column.IsSortable = IsSortable;
    _column.IsFilterable = IsFilterable;
    _column.FilterType = FilterType;
    _column.Width = Width;
    _column.Sticky = Sticky;

    if (_column.Order != Order)
    {
      _column.Order = Order;
      DataTable.ColumnsChanged();
    }
  }

  public void Dispose()
  {
    DataTable.RemoveColumn(_column);
  }
}
