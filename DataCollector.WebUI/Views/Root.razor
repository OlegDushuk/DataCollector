<div class="root">
  <Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
      @* Сторінки вимагають входу ([Authorize] у Pages/_Imports.razor); без прав - пояснення або перехід на вхід. *@
      <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
        <NotAuthorized>
          @if (context.User.Identity?.IsAuthenticated == true)
          {
            <AccessDeniedState />
          }
          else
          {
            <RedirectToLogin />
          }
        </NotAuthorized>
        <Authorizing>
          <div class="default-text">Перевірка доступу…</div>
        </Authorizing>
      </AuthorizeRouteView>
    </Found>
    <NotFound>
      <LayoutView Layout="typeof(MainLayout)">
        <NotFoundState />
      </LayoutView>
    </NotFound>
  </Router>
</div>
