@page "/"

@inherits PageBase

<PageHeader Title="Головна">
    <Subtitle>Огляд моделей даних і зібраних записів</Subtitle>
    <Actions>
        @if (Me.CanAdmin)
        {
            <Button Text="Керувати моделями" Variant="ButtonVariant.Secondary"
                    OnClick="@(() => Navigation.NavigateTo("/management"))" />
        }
    </Actions>
</PageHeader>

<div class="page page--scroll">

    <Alert Message="@Error" OnClose="@(() => Error = null)" />

    @if (_configs != null)
    {
        <div class="stats">
            <div class="stat">
                <div class="subtitle">Моделей</div>
                <div class="stat__value">@Format.Number(_configs.Count)</div>
            </div>
            <div class="stat">
                <div class="subtitle">Полів</div>
                <div class="stat__value">@Format.Number(_configs.Sum(c => (long)c.PropertyCount))</div>
            </div>
            <div class="stat">
                <div class="subtitle">Записів</div>
                <div class="stat__value">@Format.Number(_configs.Sum(c => (long)c.RecordCount))</div>
            </div>
        </div>

        @if (_configs.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state__title">Почніть з опису даних</div>
                <div class="default-text">Створіть модель - наприклад, «Замовлення» з полями «Номер», «Ціна», «Оплачено».</div>
                @if (Me.CanAdmin)
                {
                    <Button Text="Створити модель" OnClick="@(() => Navigation.NavigateTo("/management"))" />
                }
            </div>
        }
        else
        {
            <div class="cards">
                @foreach (var config in _configs)
                {
                    <div class="card card--hoverable" @onclick="@(() => Navigation.NavigateTo($"/records/{config.Key}"))">
                        <div class="card__header">
                            <div class="card__title">@config.Name</div>
                            <span class="code">@config.Key</span>
                        </div>

                        <div class="card__stats">
                            <div>
                                <div class="subtitle">Полів</div>
                                <div class="card__number">@Format.Number(config.PropertyCount)</div>
                            </div>
                            <div>
                                <div class="subtitle">Записів</div>
                                <div class="card__number">@Format.Number(config.RecordCount)</div>
                            </div>
                        </div>

                        <div class="card__footer">
                            <span class="default-text">Створено @Format.Date(config.CreatedAt)</span>
                            @if (Me.CanAdmin)
                            {
                                <IconButton Icon="edit" Title="Налаштувати"
                                            OnClick="@(() => Navigation.NavigateTo($"/management/{config.Id}"))" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (Error is null)
    {
        <div class="default-text">Завантаження…</div>
    }
</div>
